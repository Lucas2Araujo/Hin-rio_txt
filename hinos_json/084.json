    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Chegai-vos, ó crentes,",
                "vinde jubilosos,",
                "Sigamos a estrela do céu de Belém!",
                "Eis que é nascido Cristo, Rei da glória!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Ó vinde, adoremos!",
                "Ó vinde, adoremos!",
                "Ó vinde, adoremos",
                "O Rei Salvador!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ó coros celestes,",
                "plenos de harmonia,",
                "Uni-vos aos povos, cantai com fervor!",
                "Ó dai hosanas, glória nas alturas!"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Ó vinde, adoremos!",
                "Ó vinde, adoremos!",
                "Ó vinde, adoremos",
                "O Rei Salvador!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Com altos louvores,",
                "glória a Deus rendemos,",
                "Por Cristo que ao mundo desceu lá do Céu!",
                "Oh, para sempre temos Deus conosco!"
            ]
        },
        {
            "order": 6,
            "chorus": true,
