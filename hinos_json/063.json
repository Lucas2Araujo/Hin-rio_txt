    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "O mundo é de meu Deus,",
                "Senhor da criação.",
                "E todo ser que vida tem",
                "O louva em gratidão.",
                "O mundo é de meu Deus;",
                "conforta assim pensar.",
                "Deus fez o Sol e o lindo céu,",
                "Deus fez a terra e o mar."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "O mundo é de meu Deus;",
                "as aves na amplidão,",
                "O lírio branco, a luz do sol",
                "provêm de Sua mão.",
                "O mundo é de meu Deus;",
                "em tudo posso ver.",
                "Até na brisa a sussurrar",
                "percebo Seu poder."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "O mundo é de meu Deus;",
                "jamais me esquecerei.",
                "Em toda a vasta criação,",
                "somente Deus é Rei.",
                "O mundo é de meu Deus,",
                "e o Salvador Jesus,",
                "Para esta Terra resgatar,",
                "a vida deu na cruz."
            ]
        }
    ]
}