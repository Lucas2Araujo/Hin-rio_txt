    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Lembre-se do dia de bênção celestial;",
                "De toda a semana, é o dia especial.",
                "É o dia de descanso,",
                "de bênçãos e prazer.",
                "É luz pra minha vida,",
                "é paz em meu viver."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "És bem-vindo, és bem-vindo,",
                "Dia de louvor.",
                "És bem-vindo, és bem-vindo,",
                "Dia do Senhor!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Faça deste dia um dia sem igual,",
                "Pois é um dia santo, presente divinal.",
                "Se nós o observarmos",
                "com fé e com amor,",
                "Teremos muitas bênçãos",
                "que vêm do Criador."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "És bem-vindo, és bem-vindo,",
                "Dia de louvor.",
                "És bem-vindo, és bem-vindo,",
                "Dia do Senhor!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Nessas horas santas, podemos descansar.",
                "E então alegremente a Cristo adorar,",
                "O Amigo mais precioso,",
                "o nosso Salvador.",
                "Que grande privilégio",
                "fruir o Seu amor!"
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "És bem-vindo, és bem-vindo,",
                "Dia de louvor.",
                "És bem-vindo, és bem-vindo,",
                "Dia do Senhor!"
            ]
        }
    ]
