    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Tenho um hino em meu coração,",
                "Que Jesus modula assim:",
                "“Ouve, Eu contigo estou na dor,",
                "Ou no riso até ao fim.”"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "A Jesus eu louvo,",
                "Pois feliz estou.",
                "Sigo então cantando",
                "Quando após Seus passos vou."
            ]
        },
        {
            "order": 3,
            "chorus": false,
