    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Louvamos-Te, ó Deus,",
                "pelo dom de Jesus,",
                "Que por nós, pecadores,",
                "foi morto na cruz."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Aleluia! Toda a glória",
                "Te rendemos sem fim.",
                "Aleluia! Tua graça",
                "Celebramos. Amém!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Louvamos-Te, ó Deus,",
                "pelo Espírito, luz",
                "Que nos tira das trevas",
                "e a Cristo conduz."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Aleluia! Toda a glória",
                "Te rendemos sem fim.",
                "Aleluia! Tua graça",
                "Celebramos. Amém!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ó vem nos encher",
