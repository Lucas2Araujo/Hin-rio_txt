    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Se tu buscares a Jesus,",
                "Encontrarás o Salvador.",
                "A ti virá manhã de luz",
                "E paz em Seu amor."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Se buscares conhecê-Lo,",
                "Oh, sim, O amarás também!",
                "Manhã feliz despontará",
                "Para ti no lar de além."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Assim como Ele prometeu,",
                "Em teu viver desfrutarás",
                "O amor e as bênçãos lá do Céu,",
                "De Deus a doce paz."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Se buscares conhecê-Lo,",
                "Oh, sim, O amarás também!",
                "Manhã feliz despontará",
                "Para ti no lar de além."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Jesus compreende tua dor",
                "E tudo faz pra te salvar.",
                "Crê, pois, que junto ao Salvador",
                "A paz irás achar."
            ]
        },
