    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "O Espírito de Deus",
                "nos guiará pela verdade,",
                "Dizendo com clareza",
                "as coisas certas que virão.",
                "Jesus em nossa vida",
                "vencerá a falsidade",
                "No mundo que se perde",
                "em meio à escuridão."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cheios do Espírito,",
                "cheios de poder,",
                "Iremos proclamar",
                "a paz que vem da cruz.",
                "Cheios do Espírito,",
                "cheios de poder,",
                "Iremos anunciar",
                "a volta de Jesus.",
                "Cheios do Espírito,",
                "cheios de poder."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Confiantes na riqueza",
                "da glória de Jesus,",
                "Vivemos o poder",
                "de Seu Espírito em nós.",
                "Assim nós proclamamos",
                "Sua graça, eterna luz,",
                "Ao mundo que tem fome",
                "de ouvir a Sua voz."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cheios do Espírito,",
                "cheios de poder,",
                "Iremos proclamar",
                "a paz que vem da cruz.",
                "Cheios do Espírito,",
                "cheios de poder,",
                "Iremos anunciar",
                "a volta de Jesus.",
                "Cheios do Espírito,",
                "cheios de poder."
            ]
        }
    ]
