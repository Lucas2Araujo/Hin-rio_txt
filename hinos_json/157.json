    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Jesus me remiu por Seu sangue!",
                "Feliz vou pra sempre cantar.",
                "Remiu-me sem que eu merecesse.",
                "Oh, graça suprema, sem-par!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Remiu, remiu,",
                "Na cruz me remiu meu Jesus.",
                "Remiu-me, remiu-me.",
                "Por isso ando agora na luz."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Remido em Jesus por Sua graça,",
                "Não posso exprimir o prazer!",
                "A luz da divina presença",
                "Inunda pra sempre meu ser."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Remiu, remiu,",
                "Na cruz me remiu meu Jesus.",
                "Remiu-me, remiu-me.",
                "Por isso ando agora na luz."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Em meu Redentor eu medito,",
                "De dia e de noite ao deitar.",
                "Da graça tão maravilhosa",
                "Eu quero pra sempre cantar."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
