    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "A real bandeira entregou o Rei",
                "A vós, soldados Seus.",
                "Corajosos, firmes, sempre a defendei",
                "Até chegar aos Céus."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Com valor, sem temor,",
                "Por Cristo prontos a sofrer.",
                "Com a bandeira do Senhor",
                "Vamos sempre até morrer!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eis que estão formados já os batalhões",
                "De Cristo, o Vencedor.",
                "Alistai-vos hoje, bravos campeões;",
                "Avante, sem temor!"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Com valor, sem temor,",
                "Por Cristo prontos a sofrer.",
                "Com a bandeira do Senhor",
                "Vamos sempre até morrer!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "A real bandeira vamos defender",
                "De todo o coração.",
                "Os que avançam sempre sem retroceder",
                "Com Cristo reinarão."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Com valor, sem temor,",
                "Por Cristo prontos a sofrer.",
