    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Se nós quisermos vida ter,",
                "Busquemos, pois, a Deus,",
                "Colhendo as bênçãos, com prazer,",
                "Que em Seu amor nos deu."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Há perdão, poder e paz,",
                "E graça e luz, e amor gentil",
                "Em Cristo, a fonte de prazer.",
                "A Ele demos glórias e honras mil!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "O Espírito divino em mim",
                "Me livra de pecar.",
                "Em Sua graça quero assim",
                "Perdidos alcançar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Há perdão, poder e paz,",
                "E graça e luz, e amor gentil",
                "Em Cristo, a fonte de prazer.",
                "A Ele demos glórias e honras mil!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Só é possível pela fé",
                "Tais bênçãos receber.",
                "Por Cristo, o Pai concederá",
                "O reino ao que crer."
            ]
        },
