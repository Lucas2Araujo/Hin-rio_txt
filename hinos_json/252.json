    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Bem longe do Senhor vaguei;",
                "Volto agora ao lar.",
                "Veredas más eu já trilhei;",
                "Ó Deus, volto ao lar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Volto ao lar, volto ao lar;",
                "Não há mais vagar.",
                "Abre, ó Pai, os braços Teus;",
                "Volto ao lar, meu Deus."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Meu tempo em vão desperdicei;",
                "Volto agora ao lar.",
                "Lamento haver ferido a lei;",
                "Ó Deus, volto ao lar."
            ]
        },
        {
