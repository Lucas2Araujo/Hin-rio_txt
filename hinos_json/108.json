    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Foi por você também,",
                "Foi por você também",
                "que Jesus Se entregou.",
                "Vejo os cravos a rasgar",
                "Suas mãos e pés sem-par!",
                "Foi por você também",
                "que Jesus Se entregou!"
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Foi por você também,",
                "Foi por você também",
                "que o Mestre agonizou.",
                "Vejo o sangue de Jesus",
                "deslizando sobre a cruz!",
                "Foi por você também",
                "que o Mestre agonizou!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Foi por você também,",
                "Foi por você também",
                "que Jesus mostrou amor.",
                "Padeceu sem merecer",
                "e sofreu até morrer!",
                "Foi por você também",
                "que Jesus mostrou amor!"
            ]
        }
    ]
