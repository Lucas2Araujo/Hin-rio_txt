    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Contente eu já vou",
                "para o lar celestial,",
                "Caminhando, caminhando,",
                "Pois não me encanta mais",
                "o prazer terreal,",
                "Caminhando para aquele lar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Caminhando, caminhando",
                "Para aquele lar onde está Jesus.",
                "Caminhando, caminhando,",
                "Pela mão divina de Jesus."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eu quero pecadores",
                "comigo levar,",
                "Caminhando, caminhando.",
                "Que em Cristo possam eles",
                "a paz encontrar,",
                "Caminhando para aquele lar!"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Caminhando, caminhando",
                "Para aquele lar onde está Jesus.",
                "Caminhando, caminhando,",
                "Pela mão divina de Jesus."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Com Cristo, meu Senhor,",
                "para sempre estarei,",
                "Caminhando, caminhando.",
                "Seu nome eternamente",
                "então louvarei,",
                "Caminhando, sim, naquele lar."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Caminhando, caminhando",
                "Para aquele lar onde está Jesus.",
                "Caminhando, caminhando,",
                "Pela mão divina de Jesus."
            ]
        }
    ]
