    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Abre meus olhos;",
                "Eu quero ver Cristo.",
                "Eu quero tocá-Lo;",
                "Dizer que O amo.",
                "Abre os ouvidos;",
                "Eu quero ouvi-Lo.",
                "Abre meus olhos;",
                "Eu quero ver Cristo."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Toma, ó Cristo,",
                "O meu coração",
                "E guia meus passos,",
                "Sim, por Teu caminho.",
                "Eis minha vida,",
                "Eu quero estar pronto.",
                "Eu quero um dia",
                "Poder ver a Cristo."
            ]
        }
    ]
