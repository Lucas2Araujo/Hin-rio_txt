    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Perto de Jesus",
                "Sempre quero estar.",
                "Tudo o que eu preciso aqui",
                "Sempre encontro junto a Ti.",
                "Quero aqui ficar;",
                "Nunca me afastar.",
                "E abrigado em Ti, Senhor,",
                "Sinto o Teu amor por mim.",
                "Tu és o meu Deus;",
                "Quero só a Ti."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quero entregar",
                "O meu viver, Senhor.",
                "Sim, quero estar",
                "Bem junto a Ti, Jesus."
            ]
        },
