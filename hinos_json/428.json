    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eis que Cristo vem à Terra",
                "Em busca das joias,",
                "Suas joias tão preciosas,",
                "De muito valor."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Como estrelas na aurora,",
                "Brilhando em glória,",
                "Na coroa de Cristo",
                "Pra sempre estarão."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vem buscá-las, vai levá-las",
                "Ao reino celeste,",
                "Suas joias resplendentes,",
                "De muito valor."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Como estrelas na aurora,",
                "Brilhando em glória,",
                "Na coroa de Cristo",
                "Pra sempre estarão."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Os meninos e as meninas",
                "Que servem a Cristo",
                "São pra Ele ricas joias",
                "De muito valor."
            ]
        },
