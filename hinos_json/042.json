    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vive, Santo Espírito,",
                "Neste meu pobre ser.",
                "Faz no meu coração a luz",
                "Do Céu resplandecer."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Vive em mim, vive em mim,",
                "Santo e bom Consolador.",
                "Limpa do mal meu coração,",
                "Reine nele só o amor."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Fala, Santo Espírito,",
                "Fala-me com poder;",
                "Pois para a redenção real",
                "Eu quero renascer."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Vive em mim, vive em mim,",
                "Santo e bom Consolador.",
                "Limpa do mal meu coração,",
                "Reine nele só o amor."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Santo, Santo Espírito,",
                "Enche-me de fervor",
                "Para que eu ponha o meu viver",
                "Nas mãos do Salvador."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Vive em mim, vive em mim,",
                "Santo e bom Consolador.",
                "Limpa do mal meu coração,",
                "Reine nele só o amor."
            ]
        }
