    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Jesus um dia achou-me",
                "Mui longe do meu lar,",
                "Perdido já no mundo,",
                "Sem mais poder voltar.",
                "Nos braços Seus tomou-me,",
                "Por Seu amor salvou-me,",
                "O bom Pastor levou-me",
                "De volta para o lar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "A presença de Jesus",
                "Dá-me paz, prazer e luz.",
                "Cada dia cresce, mais se enriquece",
                "Esta vida com Jesus."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Andamos pelos montes",
                "Pra minha fé provar.",
                "Tão densas são as trevas!",
                "Não posso caminhar!",
                "Não há nenhum perigo,",
                "Pois Cristo está comigo,",
                "E este grande Amigo",
                "Conduz-me para o lar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "A presença de Jesus",
                "Dá-me paz, prazer e luz.",
                "Cada dia cresce, mais se enriquece",
                "Esta vida com Jesus."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Passamos pelos vales;",
                "Quão bom é relembrar!",
                "Despertam as saudades",
                "Do meu paterno lar.",
                "Oh, quão maravilhoso,",
                "Sublime e tão glorioso;",
                "O Amigo tão precioso",
                "Levar-me vai ao lar!"
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "A presença de Jesus",
                "Dá-me paz, prazer e luz.",
                "Cada dia cresce, mais se enriquece",
                "Esta vida com Jesus."
            ]
        }
    ]
