    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vida tens em olhar a Jesus, Salvador.",
                "Ele diz: “Vida eterna te dou.”",
                "Pois então, pecador,",
                "considera esse amor;",
                "Vê Jesus que na cruz expirou."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Vê, vê; viverás!",
                "Vida tens em olhar a Jesus, Salvador.",
                "Ele diz: “Vida em Mim acharás.”"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vida tens em olhar a Jesus, Salvador,",
                "Pois o Seu grande amor já provou.",
                "Com Seu sangue na cruz,",
                "e sofrendo em dor,",
                "Tua falta também já pagou."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Vê, vê; viverás!",
                "Vida tens em olhar a Jesus, Salvador.",
                "Ele diz: “Vida em Mim acharás.”"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                " Vida tens em olhar a Jesus, Salvador;",
                "Já por ti Ele tudo sofreu.",
                "Com amor dá perdão",
                "ao maior transgressor.",
                "Vê Jesus que por ti padeceu."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Vê, vê; viverás!",
                "Vida tens em olhar a Jesus, Salvador.",
                "Ele diz: “Vida em Mim acharás.”"
            ]
        }
    ]
