    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "“Todos prontos”, disse o Mestre,",
                "“A comigo padecer?”",
                "E, acordando, responderam:",
                "“Eis-nos prontos a morrer!”"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Sim, eis-nos prontos!",
                "Senhor, somos Teus!",
                "Nós vamos ser leais, ó Jesus!",
                "Vem ajudar-nos a olhar para os Céus",
                "E a ser templos Teus",
                "de paz, amor e luz."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quando virmos fortes ondas",
                "De tristeza sobre nós,",
                "“Eis-nos prontos a seguir-Te”,",
                "Ergueremos nossa voz?"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Sim, eis-nos prontos!",
                "Senhor, somos Teus!",
                "Nós vamos ser leais, ó Jesus!",
                "Vem ajudar-nos a olhar para os Céus",
                "E a ser templos Teus",
                "de paz, amor e luz."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Muito em breve, quando ao mundo",
                "Nosso Mestre regressar,",
                "Nós diremos: “Eis-nos prontos",
                "Para irmos para o lar”?"
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Sim, eis-nos prontos!",
                "Senhor, somos Teus!",
                "Nós vamos ser leais, ó Jesus!",
                "Vem ajudar-nos a olhar para os Céus",
                "E a ser templos Teus",
                "de paz, amor e luz."
            ]
        }
    ]
