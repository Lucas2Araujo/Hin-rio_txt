    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Saudai o nome de Jesus!",
                "Ó anjos, vos prostrai.",
                "O Filho do glorioso Deus,",
                "Com glória, coroai!",
                "O Filho do glorioso Deus,",
                "Com glória, coroai!"
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ó escolhida geração",
                "Do bom e eterno Pai,",
                "O grande Autor da salvação,",
                "Com glória, coroai!",
                "O grande Autor da salvação,",
                "Com glória, coroai!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ó perdoados por Jesus,",
                "Alegres adorai.",
                "O Deus de paz, o Deus de luz,",
                "Com glória, coroai!",
                "O Deus de paz, o Deus de luz,",
                "Com glória, coroai!"
            ]
        },
        {
            "order": 4,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ó povos, tribos e nações,",
                "Ao Rei divino honrai.",
                "A quem quebrou os vis grilhões,",
                "Com glória, coroai!",
                "A quem quebrou os vis grilhões,",
                "Com glória, coroai!"
            ]
        }
    ]
