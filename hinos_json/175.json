            "strophe": [
                "De Ti careço, ó Deus;",
                "Habita, pois, em mim.",
                "E vencedor serei,",
                "Fiel até o fim."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Jesus, meu Salvador,",
                "És meu anelo aqui.",
                "Vem, pois, me abençoar.",
                "Senhor, confio em Ti."
            ]
        },
        {
