    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Em toda a criação de Deus",
                "Eu vejo Seu poder,",
                "E quem contempla a linda flor",
                "Milagres pode ver."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Creio em milagres,",
                "Pois Cristo me salvou!",
                "Tão grandioso é o poder",
                "Que assim me transformou!",
                "Minh’alma escura se abriu",
                "À luz do Salvador.",
                "Creio em milagres,",
                "Pois tenho um Deus de amor!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Não posso duvidar de quem",
                "Milagres fez em mim.",
                "Perdão, felicidade, paz,",
                "Eu tenho agora, enfim."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Creio em milagres,",
                "Pois Cristo me salvou!",
                "Tão grandioso é o poder",
                "Que assim me transformou!",
                "Minh’alma escura se abriu",
                "À luz do Salvador.",
                "Creio em milagres,",
                "Pois tenho um Deus de amor!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "O Pai bondoso, em Seu poder,",
                "Renova o coração",
                "E num milagre de amor",
                "Opera a salvação"
            ]
        },
