            "strophe": [
                "Venham todos já ouvir;",
                "É a hora!",
                "Juntos vamos descobrir",
                "Lindas histórias.",
                "Grandes e pequenos,",
                "Venham aprender;",
                "O amor de Cristo",
                "Venham conhecer.",
