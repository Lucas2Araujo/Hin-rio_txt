    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Meu irmão, procura ser",
                "Tal qual Daniel;",
                "Com resolução lutar;",
                "Vencer o mal cruel."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Faze como Daniel,",
                "Serve o eterno Deus.",
                "Entre os infiéis, fiel;",
                "Marcha para os Céus."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Não se turbe o coração,",
                "Deixa a timidez.",
                "Muitos males cairão",
                "Perante a intrepidez."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Faze como Daniel,",
                "Serve o eterno Deus.",
                "Entre os infiéis, fiel;",
                "Marcha para os Céus."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Para o crente no Senhor,",
                "Há nas trevas luz.",
                "Ele avança sem temor,",
                "Em nome de Jesus."
            ]
        },
