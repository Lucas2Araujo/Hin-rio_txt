            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Em humilde oração,",
                "Quero dedicar, Senhor,",
                "Meu indigno coração",
                "Para Teu louvor.",
                "Faz-me puro, santo e bom",
                "Pra cumprir o Teu querer.",
                "Dá-me amor, Teu grande dom;",
                "Dá-me Teu poder."
            ]
        }
    ]
