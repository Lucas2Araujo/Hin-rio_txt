    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Da igreja o fundamento",
                "é Cristo, o Salvador,",
                "E Nele ela descansa,",
                "é forte em Seu amor.",
                "Em Cristo edificada,",
                "bem firme ficará,",
                "Pois sobre a Rocha eterna",
                "jamais se abalará."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "A Pedra mui preciosa",
                "que Deus providenciou",
                "Sustenta pedras vivas",
                "que a graça trabalhou.",
                "Sejamos sempre unidos,",
                "vivendo em plena luz,",
                "E a glória desta igreja",
                "será do Rei Jesus."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Em meio às duras lutas",
                "que deve confrontar,",
                "Espera a igreja, em Cristo,",
                "um dia triunfar,",
                "Pois a visão gloriosa",
                "enfim se cumprirá,",
                "E a igreja, vitoriosa,",
                "em paz repousará."
            ]
        }
    ]
}