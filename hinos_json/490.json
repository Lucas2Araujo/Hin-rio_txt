    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Tão grato me é lembrar",
                "Que cada dia estou",
                "Mais perto do celeste lar",
                "Em que morar eu vou!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cada vez mais Perto do lar,",
                "Perto do meu eterno lar",
                "Em que morar eu vou."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Em breve vou partir",
                "Para onde não há dor.",
                "Eterna vida vou fruir",
                "Naquele lar de amor."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cada vez mais Perto do lar,",
                "Perto do meu eterno lar",
                "Em que morar eu vou."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Oh, quando ali chegar,",
                "Que dia tão feliz!",
                "Descanso e paz irei achar",
                "Naquele bom país."
            ]
        },
        {
            "order": 6,
