    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Soldados de Jesus Senhor,",
                "cristãos, ó despertai!",
                "Da noite já as trevas vêm,",
                "depressa batalhai!",
                "E contra o inimigo mau",
                "saí a combater!",
                "A nossa fé vitória é,",
                "ao mundo irá vencer."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Fé é a vitória,",
                "Sim, fé sempre tem poder.",
                "Fé é a vitória:",
                "Ao mundo irá vencer."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Sob a bandeira que pra nós",
                "é o santo amor de Deus,",
                "Trilhemos o caminho aqui",
                "que leva para os Céus.",
                "Os santos crentes, pela fé,",
                "venceram Satanás.",
                "A nossa fé vitória é",
                "e a todos traz a paz."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Fé é a vitória,",
                "Sim, fé sempre tem poder.",
                "Fé é a vitória:",
                "Ao mundo irá vencer."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Aquele que viver na fé",
                "justiça alcançará.",
                "Um novo nome há de ter,",
                "perdão receberá.",
                "Assim, bem firmes, pela fé,",
                "unidos em amor,",
                "Nós venceremos no poder",
                "que vem do Salvador."
            ]
        },
        {
            "order": 6,
