                "Tu és Senhor."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Busco Tua face",
                "De manhã bem cedo,",
                "Pois Tuas bênçãos",
                "Quero receber."
            ]
        },
        {
