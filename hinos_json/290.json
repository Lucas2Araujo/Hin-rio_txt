            "strophe": [
                "Horas benditas,",
                "Santas e felizes",
                "São as que passo",
                "Junto a Ti, meu Deus"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Ó Mestre amado,",
