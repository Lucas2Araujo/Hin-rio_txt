    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ó Pai que estás no Céu,",
                "Venho Te agradecer",
                "Por Teu cuidado e amor",
                "Ao dirigir meu ser.",
                "Graças a Ti, Senhor!",
                "Meus lábios em louvor",
                "Não podem expressar",
                "Quão grato sou a Ti."
            ]
        },
