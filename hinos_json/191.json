    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quando te vêm tristezas,",
                "Dores ao coração,",
                "Olha com fé pra cima,",
                "Deus dá consolação!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Sempre! Sempre!",
                "Olha com fé para cima,",
                "Onde Jesus resplandece a luz!",
                "Olha com fé para cima!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quando os amigos fogem",
                "E abandonado estás,",
                "Olha com fé pra cima,",
                "Cristo te traz a paz."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Sempre! Sempre!",
                "Olha com fé para cima,",
                "Onde Jesus resplandece a luz!",
                "Olha com fé para cima!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Não andes cabisbaixo,",
                "Pra mais te entristecer.",
                "Olha com fé pra cima,",
                "Procura a Cristo ver."
            ]
        },
        {
            "order": 6,
