    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "No trono do viver,",
                "só existe lugar pra um,",
                "Lugar de quem governa todo o ser.",
                "No trono do viver,",
                "só pode haver um Senhor.",
                "Se forem dois, um será amado;",
                "e outro, rejeitado.",
                "Vem, decide agora",
                "quem vai ocupar seu coração,",
                "Mas lembre:"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Se Ele não for o primeiro",
                "em seu coração,",
                "Então já não é mais nada,",
                "não passa de uma ilusão.",
                "Mas se Ele for o primeiro,",
                "o seu companheiro,",
                "Motivo do seu existir,",
                "Você vai viver, você vai sorrir,",
                "você vai vencer."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Um novo dia vai",
                "nascer pra você e pra mim;",
                "Depende de aceitar Jesus no viver.",
                "É hora de beber",
                "da fonte da vida.",
                "Você verá que em Jesus existe",
                "plena alegria.",
                "Vem, decide agora",
                "quem vai ocupar seu coração,",
                "Mas lembre:"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Se Ele não for o primeiro",
                "em seu coração,",
                "Então já não é mais nada,",
                "não passa de uma ilusão.",
                "Mas se Ele for o primeiro,",
                "o seu companheiro,",
                "Motivo do seu existir,",
                "Você vai viver, você vai sorrir,",
                "você vai vencer.",
                "Você vai viver, você vai sorrir,",
                "vai vencer."
            ]
        }
    ]
