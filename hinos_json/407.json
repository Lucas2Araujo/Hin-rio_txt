    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Venho a Ti Jesus;",
                "quero renovar meu ser.",
                "Sei que a graça vem só de Ti, Senhor.",
                "Eu descobri, ó Deus,",
                "que tudo que é mau em mim",
                "Vai se transformar, com o poder do amor."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Meu Jesus,",
                "Teu amor me envolve.",
                "Quero estar",
                "Firme em Tuas mãos.",
                "Eu vou buscar",
                "Com fé a Tua graça,",
                "Vivendo em Ti, Jesus,",
                "Aceito em Tua cruz,",
                "Com o poder amor."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Abre os olhos meus;",
                "quero ver o Teu olhar.",
                "Mostra o Teu amor; vem viver em mim.",
                "Renova o meu pensar,",
                "ensina-me o Teu querer",
                "Cada dia mais, com o poder do amor."
            ]
        },
        {
