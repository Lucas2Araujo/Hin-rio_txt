    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Em Jesus confiar,",
                "Sua lei observar,",
                "Que alegria, que bênção, que paz!",
                "Satisfeitos, guardar",
                "tudo quanto ordenar;",
                "Que prazer tão imenso nos traz!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Crer e observar",
                "Tudo quanto ordenar.",
                "O fiel obedece",
                "Ao que Cristo mandar."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "O inimigo falaz",
                "e a calúnia mordaz",
                "Cristo tem o poder de afastar.",
                "Nem tristeza, nem dor,",
                "nem a intriga maior",
                "Poderão ao fiel abalar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Crer e observar",
                "Tudo quanto ordenar.",
                "O fiel obedece",
                "Ao que Cristo mandar."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Resolutos, Senhor,",
                "e com fé, zelo e ardor,",
                "Os Teus passos queremos seguir.",
                "Teus preceitos guardar,",
                "o Teu nome exaltar;",
                "Sempre a Tua vontade cumprir."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Crer e observar",
                "Tudo quanto ordenar.",
                "O fiel obedece",
                "Ao que Cristo mandar."
            ]
        }
    ]
