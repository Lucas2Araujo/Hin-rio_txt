    "lyrics": [
        {
            "order": 1,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cada dia que houver pra mim,",
                "Cada ave a voar",
                "É motivo pra eu sorrir;",
                "É razão pra cantar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cada dia que houver pra mim,",
                "Cada ave a voar",
                "É motivo pra eu sorrir;",
                "É razão pra cantar."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eu não canso de olhar",
                "O horizonte sem fim,",
                "A grandeza do mar",
                "Ou a paz de um jardim.",
                "Sinto a chuva cair;",
                "Sinto a brisa do ar.",
                "Vejo a terra sorrir;",
                "Vejo a vida chegar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cada dia que houver pra mim,",
                "Cada ave a voar",
                "É motivo pra eu sorrir;",
                "É razão pra cantar."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Cada dia ao nascer",
                "Traz no sol o seu calor;",
                "Cada raio a brilhar",
                "É um poema de amor.",
                "Eu não canso de ouvir",
                "Tantos sons pelo ar,",
                "As canções dos pardais,",
                "Ou a fonte a jorrar."
            ]
        },
