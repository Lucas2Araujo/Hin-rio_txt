    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "A manhã gloriosa está raiando;",
                "Logo o Rei virá.",
                "E Seu povo, então, para o lar eterno",
                "Ele levará."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "A manhã gloriosa está raiando;",
                "Breve surgirá a luz!",
                "A manhã gloriosa está raiando;",
                "Eis que vem Jesus!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Inda se ouve o som do evangelho eterno;",
                "Não vos demoreis,",
                "Pois bem cedo vem, e com majestade,",
                "Cristo, o Rei dos reis!"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "A manhã gloriosa está raiando;",
                "Breve surgirá a luz!",
                "A manhã gloriosa está raiando;",
                "Eis que vem Jesus!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Voltarão à vida os queridos mortos,",
                "Em exultação!",
                "Que alegria infinda nos encontrarmos",
                "Na eternal mansão!"
            ]
        },
