    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Para além das montanhas,",
                "no celeste lar,",
                "A cidade santa nos espera já;",
                "‘Stamos tão cansados de subir, galgar,",
                "Mas, avante, sempre,",
                "não desanimar!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Perto, sim, do lar!",
                "Perto, sim, do lar!",
                "Eis as luzes deste deslumbrante lar!",
                "E esplendores junto aos",
                "seus portais sem-par!",
                "Perto está o dia de rever Jesus",
                "E subir com Ele para a Sua luz!",
                "Perto, sim, do lar!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Os profetas antigos",
                "nos falaram já",
                "Da cidade bela de ouro e de cristal.",
                "Já nos vêm vislumbres, divisamos lá",
                "As mansões brilhantes",
                "como há nada igual."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Perto, sim, do lar!",
                "Perto, sim, do lar!",
                "Eis as luzes deste deslumbrante lar!",
                "E esplendores junto aos",
                "seus portais sem-par!",
                "Perto está o dia de rever Jesus",
                "E subir com Ele para a Sua luz!",
                "Perto, sim, do lar!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Neste lar tão somente",
                "poderão entrar",
                "Os remidos pela graça de Jesus.",
                "Nossas vozes juntas hão de ali vibrar",
                "Em louvor Àquele",
                "que morreu na cruz."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Perto, sim, do lar!",
                "Perto, sim, do lar!",
                "Eis as luzes deste deslumbrante lar!",
                "E esplendores junto aos",
                "seus portais sem-par!",
                "Perto está o dia de rever Jesus",
                "E subir com Ele para a Sua luz!",
                "Perto, sim, do lar!"
            ]
        },
        {
            "order": 7,
            "chorus": false,
            "image": "",
            "strophe": [
                "Para entrar neste lar",
                "de paz, amor e luz,",
                "Uma terra linda, sem tristeza ou dor,",
                "Aceitemos, pois, a graça de Jesus",
                "E em Seu reino",
                "nos receberá co’amor."
            ]
        },
