    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Se não houver o amanhã,",
                "Se o sol não nascer,",
                "E o vento parar de soprar sobre nós,",
                "Se não ouvir mais o mar,",
                "O cantar dos pardais,",
                "Nem puder ver as nuvens no céu a passar,"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Dormindo ali estarei,",
                "Esperando meu Rei",
                "A chamar-me com amor,",
                "Me avisando que o dia mais lindo",
                "já chegou.",
                "Agora posso ouvir,",
                "Posso ver e sorrir",
                "E pra sempre viver",
                "Sem mais nada a temer;",
                "E assim bem feliz eu serei",
                "Quando chegar o amanhã."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Se eu não vir mais o sol,",
                "Não mais vale o falar,",
                "Perguntar ou querer,",
                "e homenagens fazer.",
                "Ali eu nada terei,",
                "Só lembranças serei",
                "Na memória de quem eu um dia servi."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Dormindo ali estarei,",
                "Esperando meu Rei",
                "A chamar-me com amor,",
                "Me avisando que o dia mais lindo",
                "já chegou.",
                "Agora posso ouvir,",
                "Posso ver e sorrir",
                "E pra sempre viver",
                "Sem mais nada a temer;",
                "E assim bem feliz eu serei",
                "Quando chegar o amanhã."
            ]
        }
    ]
