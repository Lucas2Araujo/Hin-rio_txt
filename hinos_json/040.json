    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Concede-nos, ó Deus,",
                "o Espírito de amor,",
                "E ao nosso coração,",
                "o Teu Consolador.",
                "No mundo atroz,",
                "Que sempre o Santo Espírito",
                "esteja em nós!"
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Convença o mundo então",
                "do juízo e do mal",
                "E da justiça, enfim,",
                "com graça divinal.",
                "Concede, ó Deus,",
                "Que andem na Verdade aqui",
                "os filhos Teus."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Permite-nos aqui",
                "louvar a Deus, o Pai;",
                "E ao Filho em alta voz,",
                "ó povos, glória dai.",
                "Louvai também",
                "O bom e Santo Espírito",
                "pra sempre. Amém!"
            ]
        }
    ]
}