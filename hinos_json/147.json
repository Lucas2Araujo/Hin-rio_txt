            "chorus": false,
            "image": "",
            "strophe": [
                "Pecadores, vinde já,",
                "Cristo vos quer salvar.",
                "Seu perdão, conforto e paz",
                "Ele vos pode dar.",
                "Sua luz e Seu amor",
                "sempre concederá.",
                "Vosso coração Jesus transformará."
            ]
        },
