    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Venho aqui agora",
                "Nesta oração",
                "Pedir a Tua graça",
                "Pra cumprir minha missão.",
                "Quero ser a bênção,",
                "Luz por onde for,",
                "Levando a esperança,",
                "Em plena confiança,",
                "Que a mão que nos alcança",
                "É a mão do Salvador."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Muitos que precisam",
                "Quero ajudar,",
                "Levando o evangelho,",
                "E a Cristo revelar.",
                "Faz-me justo e digno",
                "Pra eu mostrar amor:",
                "A mão sempre estendida,",
                "A voz que aquece a vida,",
                "A face tão querida",
                "De Cristo, o Salvador."
            ]
        }
    ]
