        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ó vem, ó vem, Emanuel,",
                "E salva o aflito Israel",
                "Que chora o exílio em seu viver",
                "Até Jesus aparecer."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cantai! Cantai! Emanuel",
                "Virá a vós, ó Israel!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Sabedoria que é do além,",
                "Ordena tudo aqui também.",
                "O bom caminho vem mostrar",
                "E como nele sempre andar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Cantai! Cantai! Emanuel",
