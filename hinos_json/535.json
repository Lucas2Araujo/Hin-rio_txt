    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "São dez os mandamentos",
                "da santa lei de Deus,",
                "Que podem ser contados",
                "nos dez dedinhos meus.",
                "Os meus dois olhinhos",
                "servem para os ler,",
                "E estes meus dedinhos,",
                "para os escrever."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Dos dez preceitos, quatro",
                "nos dizem quanto amor",
                "Devemos a Jesus,",
                "que é nosso Criador.",
                "Os meus dois ouvidos",
                "servem para ouvir;",
                "A boquinha minha,",
                "para os proferir."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Amai aos semelhantes,",
                "exortam os finais;",
                "Amai como a vós mesmos,",
                "e a Deus sereis leais.",
                "Os meus dois pezinhos",
                "servem para andar",
                "Pelo bom caminho",
                "sempre rumo ao lar."
            ]
        }
    ]
