    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Que prazer é pensar",
                "no meu lar celestial,",
                "Onde irei habitar, afinal!",
                "Quando, enfim, por Jesus,",
                "conseguir lá chegar,",
                "Na coroa eu estrelas terei!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Na coroa de luz, eu estrelas terei,",
                "Quando o sol não aqui mais raiar!",
                "Quando Deus me levar",
                "para o reino dos Céus,",
                "Na coroa eu estrelas terei!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "No poder de Jesus,",
                "vou orar e lutar,",
                "Para o Céu muita gente guiar.",
                "Quero, pois, receber",
                "nesse dia final",
                "A coroa de glória a brilhar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Na coroa de luz, eu estrelas terei,",
                "Quando o sol não aqui mais raiar!",
                "Quando Deus me levar",
                "para o reino dos Céus,",
                "Na coroa eu estrelas terei!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Que alegria será",
                "a Jesus contemplar",
                "E a Seus pés com louvor adorar!",
                "Na cidade eternal,",
                "minha glória será",
                "Receber a coroa a brilhar."
            ]
        },
