    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Alegro-me em proclamar",
                "a história de Jesus,",
                "Que veio lá da glória",
                "morrer na amarga cruz.",
                "Sim, quero proclamá-la,",
                "pois ela satisfaz",
                "Anseios de minh’alma",
                "e enche-me de paz."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Oh, doce e bela história",
                "De Cristo, o Salvador,",
                "De Sua eterna graça,",
                "De Seu imenso amor!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Desejo sempre repetir",
                "a história desse amor",
                "Que trouxe nova vida.",
                "Oh, glória ao Salvador!",
                "E Cristo ainda hoje,",
                "com terna compaixão,",
                "Procura pecadores",
                "e dá-lhes o perdão."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Oh, doce e bela história",
                "De Cristo, o Salvador,",
                "De Sua eterna graça,",
                "De Seu imenso amor!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Sim, dessa história vou falar",
                "pra sempre com fervor,",
                "Pois muitos inda vivem",
                "nas trevas e na dor.",
                "E mesmo lá na glória,",
                "ao meu Jesus voltar,",
                "Tão linda e doce história",
                "eu hei de celebrar."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Oh, doce e bela história",
                "De Cristo, o Salvador,",
                "De Sua eterna graça,",
                "De Seu imenso amor!"
            ]
        }
    ]
