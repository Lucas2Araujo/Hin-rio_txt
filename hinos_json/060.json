    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ao Deus de Abraão louvai,",
                "supremo Criador,",
                "Eterno Deus, bondoso Pai",
                "e Rei, Senhor.",
                "O grande Deus Eu Sou",
                "céu, terra e mar formou.",
                "Meu ser também dará louvor",
                "ao Deus de amor."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ao Deus de Abraão louvai,",
                "eterno Benfeitor.",
                "O povo Seu um dia vai",
                "ao lar de amor.",
                "O mundo mau deixei,",
                "seu brilho e seu prazer,",
                "E filho, então, de Deus serei",
                "até morrer."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ao Deus de Abraão louvai;",
                "os anjos dão louvor.",
                "E vós também louvores dai",
                "ao Deus de amor.",
                "Ao Deus de Abraão e meu",
                "no além irei louvar.",
                "Eternamente eu louvarei",
                "ao Deus sem-par."
            ]
        }
    ]
