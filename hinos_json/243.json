    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Jesus, Pastor amado,",
                "contempla-nos aqui;",
                "Concede que sejamos",
                "um corpo só, em Ti.",
                "Contendas e malícias",
                "de nós bem longe vão;",
                "Nenhum desgosto impeça",
                "a nossa comunhão."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Por sermos resgatados",
                "por um só Salvador,",
                "Devemos ser unidos",
                "por santo e forte amor;",
                "Olhar com paciência",
                "os erros de um irmão,",
                "E todos ajudá-lo,",
                "com terna compaixão"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Jesus, suave e meigo,",
                "ensina-nos a amar,",
                "E faz-nos bem-dispostos",
                "também no perdoar.",
                "Oh, quanto carecemos",
                "do auxílio do Senhor!",
                "Unidos, suplicamos",
                "a Ti por esse amor."
            ]
        },
        {
            "order": 4,
            "chorus": false,
            "image": "",
            "strophe": [
                "Senhor, se a igreja toda",
                "andar em santa união,",
                "Então será bendito",
                "o nome de cristão.",
                "Assim o que pediste",
                "em nós se cumprirá;",
                "O mundo, em nós, Teus filhos,",
                "a Ti distinguirá."
            ]
        }
    ]
}