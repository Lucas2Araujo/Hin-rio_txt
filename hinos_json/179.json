    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Não sei por que de Deus o amor",
                "A mim se revelou.",
                "Por qual razão o Salvador",
                "Pra Si me resgatou."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Mas eu sei em quem eu creio",
                "E estou bem certo que é poderoso",
                "Pra guardar o meu tesouro",
                "Até o fim chegar."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Não sei o que de mal ou bem",
                "Aqui enfrentarei;",
                "Se maus ou calmos dias vêm,",
                "Se lutas eu terei."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Mas eu sei em quem eu creio",
                "E estou bem certo que é poderoso",
                "Pra guardar o meu tesouro",
                "Até o fim chegar."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                " Não sei também o dia em que",
                "Verei Jesus voltar;",
                "Se de manhã, se à tarde vem",
                "Pra me levar ao lar."
            ]
        },
        {
            "order": 6,
            "chorus": true,
