    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Senhor, Tu nos convidas",
                "a Ceia a celebrar;",
                "Deixar as nossas lidas",
                "e o Teu favor ganhar.",
                "Por nós provaste a morte",
                "e dás o vinho e o pão,",
                "Que são um simbolismo",
                "de fé na redenção"
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Do Céu o Pão partido",
                "em dores e aflição",
                "Por Deus oferecido",
                "nos trouxe a salvação.",
                "A taça de amargura",
                "tomaste Tu, Jesus!",
                "Mas taça de doçura",
                "nos dás em vez de cruz."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Senhor, Teu sacrifício",
                "proveu libertação,",
                "Nos trouxe vida nova,",
                "nos deu a redenção.",
                "Ao Céu acesso temos",
                "por Ti, Jesus Senhor;",
                "Agora compreendemos",
                "o Teu eterno amor."
            ]
        }
    ]
}