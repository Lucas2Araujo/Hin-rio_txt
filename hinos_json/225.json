    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Uma voz ressoa",
                "num geral clamor:",
                "Dai-nos luz, dai-nos luz!",
                "Os milhões em trevas,",
                "cheios de pavor,",
                "Pedem luz, pedem luz!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Dai-nos luz, a mui gloriosa luz",
                "De perdão, de paz e amor!",
                "Dai-nos luz, a tão preciosa luz",
                "De Jesus, o Salvador!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Sim, por toda parte",
                "deve reluzir",
                "Essa luz de Jesus,",
                "Que aponta o bom",
                "caminho a seguir.",
                "Dai-nos luz, dai-nos luz!"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Dai-nos luz, a mui gloriosa luz",
                "De perdão, de paz e amor!",
                "Dai-nos luz, a tão preciosa luz",
                "De Jesus, o Salvador!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vamos, pois, cristãos,",
                "o mundo todo encher",
                "Dessa luz de Jesus!",
                "Aos milhões sem",
                "Cristo sem tardar erguer",
                "Essa luz de Jesus!"
            ]
        },
        {
            "order": 6,
