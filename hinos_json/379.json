    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Fala à minh’alma, ó Cristo,",
                "fala-lhe com amor!",
                "Dize-lhe com ternura:",
                "“Eu sou teu Salvador!”",
                "Faze-me bem-disposto",
                "para Te obedecer;",
                "Sempre louvar Teu nome",
                "e Te entregar meu ser."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Faze-me ouvir bem manso,",
                "em suave murmurar:",
                "“Eu já verti Meu sangue,",
                "para te libertar.”",
                "Fala-me cada dia,",
                "fala com todo amor,",
                "Dize-me com ternura:",
                "“Tu tens um Salvador!”"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Fala aos Teus filhos sempre,",
                "dá-lhes a direção.",
                "Enche-os de alegria,",
                "mesmo na provação.",
                "Faze-os bem consagrados,",
                "prontos a trabalhar,",
                "Para do reino eterno",
                "a vinda abreviar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Faze-me ouvir bem manso,",
                "em suave murmurar:",
                "“Eu já verti Meu sangue,",
                "para te libertar.”",
                "Fala-me cada dia,",
                "fala com todo amor,",
                "Dize-me com ternura:",
                "“Tu tens um Salvador!”"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Como na antiguidade",
                "mostravas Teu querer,",
                "Dize-me hoje e sempre",
                "qual seja meu dever.",
                "A Ti somente eu quero",
                "louvores entoar;",
                "Teu nome eternamente",
                "engrandecer e honrar."
            ]
        },
        {
            "order": 6,
