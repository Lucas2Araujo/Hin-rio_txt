    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Sou forasteiro aqui,",
                "em terra estranha estou;",
                "Do reino lá do Céu,",
                "embaixador eu sou.",
                "Meu Rei e Salvador",
                "vos manda em Seu amor",
                "As boas-novas de perdão."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "O Salvador em Seu amor",
                "Vos dá mensagem lá dos Céus:",
                "“Reconciliai-vos já”, é ordem que Ele dá.",
                "“Reconciliai-vos já com Deus!”"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "É ordem do meu Rei",
                "que todo pecador",
                "Arrependido já",
                "se volte ao Salvador,",
                "E salvação terá,",
                "pois Cristo prometeu",
                "Dar o perdão por Seu amor."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "O Salvador em Seu amor",
                "Vos dá mensagem lá dos Céus:",
                "“Reconciliai-vos já”, é ordem que Ele dá.",
                "“Reconciliai-vos já com Deus!”"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "No meu eterno lar",
                "não haverá temor,",
                "Nem lutas e aflições,",
                "nem mais tristeza ou dor.",
                "E os redimidos lá",
                "então receberão",
                "As boas-vindas do Senhor."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "O Salvador em Seu amor",
                "Vos dá mensagem lá dos Céus:",
                "“Reconciliai-vos já”, é ordem que Ele dá.",
                "“Reconciliai-vos já com Deus!”"
            ]
        }
    ]
