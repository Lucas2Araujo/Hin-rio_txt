    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Natal, feliz Natal!",
                "No céu de Belém,",
                "Uma luz que surgiu",
                "fez soar, lá no além,",
                "O coro angelical",
                "que em sons divinais",
                "Proclamou, lá do Céu,",
                "salvação aos mortais."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Natal, feliz Natal!",
                "Natal, Natal!",
                "Eis que nasceu",
                "Nosso Rei divinal!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "A paz então reinou",
                "em céu, terra e mar",
                "Ao descer sobre o Rei",
                "uma luz estelar.",
                "A luz do Salvador",
                "brilhou mais e mais",
                "E guiou a Seus pés",
                "nobres reis orientais."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Natal, feliz Natal!",
                "Natal, Natal!",
                "Eis que nasceu",
                "Nosso Rei divinal!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "A luz que fez reinar",
                "a paz divinal,",
                "Que encheu todo o céu",
                "de fulgor sideral,",
                "A luz que ainda está",
                "no céu a luzir",
                "Vem também nossos pés",
                "a Jesus conduzir."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Natal, feliz Natal!",
                "Natal, Natal!",
                "Eis que nasceu",
                "Nosso Rei divinal!"
            ]
        }
    ]
