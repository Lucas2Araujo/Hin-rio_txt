    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vamos nós trabalhar,",
                "somos servos de Deus,",
                "Com o Mestre seguir",
                "no caminho dos Céus;",
                "Pelo Seu santo amor",
                "o vigor renovar,",
                "E fazer, diligentes, o que Ele ordenar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "No labor, com fervor,",
                "A servir a Jesus,",
                "Com desvelo e fé e com oração,",
                "Até voltar o Redentor!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vamos nós trabalhar,",
                "os famintos fartar;",
                "Para a fonte do bem",
                "os sedentos levar.",
                "Só a cruz do Senhor",
                "nossa glória será,",
                "Pois Jesus salvação pela graça nos dá."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "No labor, com fervor,",
                "A servir a Jesus,",
                "Com desvelo e fé e com oração,",
                "Até voltar o Redentor!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vamos nós trabalhar",
                "ajudados por Deus,",
                "Que coroa real",
                "nos dará lá nos Céus.",
                "Na mansão dos fiéis",
                "o descanso será,",
                "Pois Jesus salvação pela graça nos dá."
            ]
        },
