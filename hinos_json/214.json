    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eu sou o Senhor,",
                "Rei de Israel,",
                "Santo Redentor,",
                "Começo e o fim.",
                "Sou o Criador,",
                "O verdadeiro Deus,",
                "Eu sou a cura,",
                "Sou o Poder."
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eu sou o Amém,",
                "Estrela da Manhã,",
                "Eu morri na cruz,",
                "Trouxe salvação.",
                "Conheço a tua dor,",
                "Ouço o teu clamor",
                "E minha destra não falhará."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Não há o que temer,",
                "Contigo eu estou.",
                "Não te assombres",
                "Porque eu sou o teu Deus.",
                "Te fortalecerei, te sustentarei",
                "Com minha mão.",
                "Eu serei fiel."
