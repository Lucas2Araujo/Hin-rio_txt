    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vestido em linho Jesus desceu,",
                "Trazendo salvação.",
                "De mirra o bálsamo traz do Céu",
                "Beleza e perfeição."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Vindo ao mundo, deixou no Céu",
                "Palácios de marfim.",
                "Glória não quis, em dor morreu.",
                "A cruz suportou por mim."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Trazendo em Si de aloés o odor,",
                "A morte atroz sofreu.",
                "Provou aqui amargura e dor;",
                "Ao mundo abriu o Céu."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Vindo ao mundo, deixou no Céu",
                "Palácios de marfim.",
                "Glória não quis, em dor morreu.",
                "A cruz suportou por mim."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Odor de cássia as vestes têm;",
                "Sim, Ele ressurgiu.",
                "E junto ao Pai Se assentou no além;",
                "Ao mundo redimiu."
            ]
        },
