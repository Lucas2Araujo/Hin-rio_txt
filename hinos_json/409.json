    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Tudo é belo ao meu redor",
                "com amor no lar.",
                "Há beleza em cada flor",
                "com amor no lar.",
                "Esse amor promove paz,",
                "toda mágoa e dor desfaz.",
                "Luz, saúde e vida traz",
                "sempre o amor no lar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Com amor, com amor,",
                "Não há dor, não há pesar,",
                "Com amor no lar."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Nossa vida tem prazer",
                "com amor no lar.",
                "Ódio e mal não pode haver",
                "com amor no lar.",
                "Cada rosa em seu matiz,",
                "vozes de aves tão gentis,",
                "Tudo fica mais feliz",
                "com amor no lar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Com amor, com amor,",
                "Não há dor, não há pesar,",
                "Com amor no lar."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Meu Jesus, que eu seja Teu;",
                "dá-me amor no lar.",
                "Quero renunciar ao eu,",
                "quero mais amar.",
                "Vida mais feliz terei,",
                "hei de estar aos pés do Rei,",
                "Sempre andando em Sua lei,",
                "com amor no lar."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Com amor, com amor,",
                "Não há dor, não há pesar,",
                "Com amor no lar."
            ]
        }
    ]
