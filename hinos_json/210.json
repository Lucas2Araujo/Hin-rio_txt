    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quando a minha esperança acabar,",
                "Quando o sol pra mim não brilhar,",
                "Eu só preciso a Jesus recorrer,",
                "Pois Dele me vem o poder. "
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Em Deus vou sempre confiante;",
                "Vou avante pra vencer.",
                "Em Deus vou sempre confiante;",
                "Vou sem mais temer."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
