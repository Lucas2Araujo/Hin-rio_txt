    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Obedecer é melhor",
                "do que sacrificar.",
                "Melhor é sempre atender a Deus",
                "e a lei guardar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "A Deus, com fé, nossa alma volvamos,",
                "À Sua lei obedeçamos,",
                "Pois obedecer é melhor",
                "do que sacrificar.",
                "Melhor é sempre atender a Deus",
                "E a lei guardar."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Dizeis que não é preciso mais",
                "a lei guardar?",
                "Olhai que a Bíblia em lugar algum",
                "a faz tombar."
            ]
        },
        {
            "order": 4,
            "chorus": true,
