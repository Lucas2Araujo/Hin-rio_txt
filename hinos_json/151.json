    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Buscou-me com ternura",
                "Jesus, o bom Pastor.",
                "Achou-me na miséria,",
                "salvou-me com amor.",
                "No Céu, os anjos, em canção,",
                "Mostraram sua aprovação."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Oh, que amor glorioso!",
                "Preço tão grandioso",
                "Que Jesus por mim na cruz pagou!",
                "Graça sem igual me resgatou!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ferido, abandonado,",
                "Jesus me socorreu.",
                "E segredou-me: “Achei-te;",
                "de agora em diante és Meu.”",
                "Tão meiga voz jamais ouvi!",
                "Prazer maior jamais senti!"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Oh, que amor glorioso!",
                "Preço tão grandioso",
                "Que Jesus por mim na cruz pagou!",
                "Graça sem igual me resgatou!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Enquanto as horas passam,",
                "eu vivo em doce paz",
                "E aguardo o meu bom Mestre,",
                "que tão feliz me faz!",
                "A mim Jesus virá buscar,",
                "E então com Ele irei morar."
            ]
        },
        {
            "order": 6,
            "chorus": true,
