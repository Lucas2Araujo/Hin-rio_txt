    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Escutai a voz de Deus:",
                "é Jesus o Salvador!",
                "Ó clamai, vós, filhos Seus:",
                "é Jesus o Salvador.",
                "Proclamai com grande ardor",
                "salvação ao pecador,",
                "Pois Jesus aqui morreu",
                "para ser o Salvador!"
            ]
        },
        {
            "order": 2,
            "chorus": false,
            "image": "",
            "strophe": [
                "Abraçai o excelso dom:",
                "é Jesus o Salvador!",
                "Pela cruz vos dá perdão:",
                "é Jesus o Salvador.",
                "Multidões, oh, exultai;",
                "Seu amor considerai!",
                "Anjos Seus também clamai:",
                "é Jesus o Salvador!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Ó fiéis, a voz erguei:",
                "é Jesus o Salvador!",
                "Vós, nações, louvor rendei:",
                "é Jesus o Salvador!",
                "Salvação de graça dá,",
                "e perdão concederá!",
                "Glórias mil a Deus Jeová,",
                "pois Jesus é o Salvador!"
            ]
        }
    ]
