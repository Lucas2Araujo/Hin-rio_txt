    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Pai, eu me achego a Ti,",
                "pois Tua voz ouvi.",
                "Teu grande amor senti,",
                "ó meu Senhor!",
                "Não poderei viver",
                "só, sem o Teu poder.",
                "Vem inundar meu ser",
                "com Teu amor!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Pai, eu me achego a Ti;",
                "Sou pecador.",
                "Que me conforte aqui",
                "Teu santo amor!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Pai, quão distante andei,",
                "só, quebrantando a lei,",
                "Sem Tua luz, bem sei,",
                "sem salvação.",
                "Sou pecador e vil,",
                "sim, com defeitos mil.",
                "Ó dá-me em Teu redil",
                "paz e perdão!"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Pai, eu me achego a Ti;",
                "Sou pecador.",
                "Que me conforte aqui",
                "Teu santo amor!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Teu quero ser, Senhor,",
                "ser luz por onde for.",
                "Que eu tenha mais fervor,",
                "mais mansidão!",
                "Em minha vida, ó Deus,",
                "põe os caminhos Teus.",
                "Vem, vem guiar-me aos Céus",
                "com Tua mão!"
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Pai, eu me achego a Ti;",
                "Sou pecador.",
                "Que me conforte aqui",
                "Teu santo amor!"
            ]
        }
    ]
