    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "A vida tem tristezas mil;",
                "Nem tudo é um céu de anil.",
                "Mas contra a dor, que é tão hostil,",
                "Há um caminho só:"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Confia em Deus,",
                "que Ele sempre te ouvirá.",
                "Confia em Deus,",
                "que Ele nunca falhará.",
                "Confia em Deus,",
                "que a escura nuvem passará.",
                "Oh, não duvides, mas confia em Deus."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quando teu céu escurecer",
                "E enfrentares teu sofrer,",
                "Se queres forças receber,",
                "Há um caminho só:"
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
