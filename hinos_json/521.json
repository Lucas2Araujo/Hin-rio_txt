            "strophe": [
                "Nos caminhos da vida,",
                "por onde eu andar,",
                "O Espírito Santo",
                "me conduzirá.",
                "Sua voz é meu guia,",
                "me traz o poder;",
                "Ele é minha força",
                "pra tudo vencer.",
                "Amém, amém!"
            ]
        }
