    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quero estar ao pé da cruz,",
                "De onde rica fonte",
                "Corre franca e salutar",
                "Sobre o rude monte."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Sim, na cruz, sim, na cruz",
                "Sempre me glorio.",
                "Té que ao fim vá descansar,",
                "Salvo, além do rio."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Desta cruz, Jesus, meu Deus,",
                "Vem, sim, recordar-me.",
                "Dela, à sombra, ó Salvador,",
                "Queiras abrigar-me."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Sim, na cruz, sim, na cruz",
                "Sempre me glorio.",
                "Té que ao fim vá descansar,",
                "Salvo, além do rio."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Junto à cruz, ardendo em fé,",
                "Sem temor vigio,",
                "Pois ao lar paterno irei,",
                "Salvo, além do rio."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Sim, na cruz, sim, na cruz",
                "Sempre me glorio.",
                "Té que ao fim vá descansar,",
                "Salvo, além do rio."
            ]
        }
    ]
