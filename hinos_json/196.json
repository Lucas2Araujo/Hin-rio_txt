    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Dias turvos há",
                "em que busco em vão",
                "O semblante de meu Jesus,",
                "Mas em meio às trevas eu vejo a luz",
                "Ao Jesus me tomar a mão."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Ao Jesus me tomar a mão!",
                "Ao Jesus me tomar a mão!",
                "Sinto vir do Céu força em Seu poder,",
                "Ao Jesus me tomar a mão."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quando fraco estou",
                "sem poder lutar",
                "E tentado a desanimar,",
                "Sinto a fé voltar e me animo então,",
                "Ao Jesus me tomar a mão."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
