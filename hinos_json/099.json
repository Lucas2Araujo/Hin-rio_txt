    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Conta-me a velha história,",
                "suave, com dulçor,",
                "De meu Jesus e Sua glória,",
                "de Cristo e Seu amor,",
                "Com calma e com paciência,",
                "pois quero alcançar",
                "A altura do mistério:",
                "que Deus nos pode amar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Conta-me a velha história,",
                "Velha e sublime história!",
                "Conta-me, pois, a história",
                "Do meigo Salvador!"
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Fala-me com doçura",
                "do meigo Redentor,",
                "De Seu amor e Sua graça,",
                "pois sou um pecador.",
                "Sim, para o meu conforto,",
                "em tempos de aflição,",
                "Repete a velha história",
                "de amor e salvação."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Conta-me a velha história,",
                "Velha e sublime história!",
                "Conta-me, pois, a história",
                "Do meigo Salvador!"
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Se o brilho deste mundo",
                "cobrir do Céu a luz,",
                "Repete então a mesma história",
                "da graça de Jesus.",
                "E quando, enfim, a glória",
                "do mundo além raiar,",
                "Oh, conta a mesma história:",
                "que veio aqui salvar."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Conta-me a velha história,",
                "Velha e sublime história!",
                "Conta-me, pois, a história",
                "Do meigo Salvador!"
            ]
        }
    ]
