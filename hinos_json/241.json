    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "A todo semelhante meu",
                "Contarei que Deus é amor.",
                "O mundo desconhece o bem",
                "E Jesus, o Redentor."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Falarei de Deus",
                "E do Seu amor.",
                "Para o mundo mostrarei Jesus",
                "Com maior fervor."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Da eterna graça sem igual",
                "Aos perdidos falarei,",
                "Guiando-os deste mundo mau",
                "Para os pés do amado Rei."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Falarei de Deus",
                "E do Seu amor.",
                "Para o mundo mostrarei Jesus",
                "Com maior fervor."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Mais vasto que o imenso mar",
                "É de Deus o grande amor.",
                "Eu quero então o proclamar",
                "Para todo pecador."
            ]
        },
