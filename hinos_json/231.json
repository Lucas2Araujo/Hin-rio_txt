    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eu quero trabalhar por meu Senhor,",
                "Confiante em Seu poder, em Seu amor.",
                "Vou orar e trabalhar",
                "e ocupado sempre estar",
                "Na seara do Senhor."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Trabalhar e orar",
                "Fielmente na seara do Senhor.",
                "Meu anelo é orar",
                "e ocupado sempre estar",
                "Na seara do Senhor."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eu quero cada dia trabalhar;",
                "Escravos do pecado libertar.",
                "E levá-los a Jesus,",
                "nosso Guia, nossa luz,",
                "Na seara do Senhor."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Trabalhar e orar",
                "Fielmente na seara do Senhor.",
                "Meu anelo é orar",
                "e ocupado sempre estar",
                "Na seara do Senhor."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Eu quero ser obreiro de valor,",
                "Confiante no poder do Salvador.",
                "E quem queira trabalhar",
                "achará também lugar",
                "Na seara do Senhor."
            ]
        },
        {
