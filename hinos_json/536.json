    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "São dez os mandamentos",
                "Que a lei de Deus nos dá.",
                "Se a eles obedeço,",
                "Aprendo a amar."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Com os quatro primeiros, eu amo a Deus;",
                "Com os últimos seis, a meu irmão.",
                "E assim eu vivo bem feliz em paz e união."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Quando eu busco fazer",
                "O que a lei me diz,",
                "Deus fica tão contente,",
                "E eu fico mais feliz."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Com os quatro primeiros, eu amo a Deus;",
                "Com os últimos seis, a meu irmão.",
                "E assim eu vivo bem feliz em paz e união."
            ]
        }
    ]
