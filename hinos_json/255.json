    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Nas claras águas deste mar,",
                "Os meus pecados deixarei.",
                "Depois, então, irei morar",
                "Com o divino Rei."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Deixarei no mar",
                "Minhas culpas deixarei, deixarei.",
                "Deixarei no mar",
                "E no Céu irei morar."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Desejo agora consagrar",
                "A minha vida ao Salvador,",
                "Deixando todo o meu pesa",
                "Aos pés do Redentor."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Deixarei no mar",
                "Minhas culpas deixarei, deixarei.",
                "Deixarei no mar",
                "E no Céu irei morar."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Aqui as culpas vou deixar,",
                "E vida nova então terei.",
                "E assim um dia irei morar",
                "Com o divino Rei."
            ]
        },
