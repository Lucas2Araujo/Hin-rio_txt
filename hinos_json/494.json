    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "À terra nós vamos",
                "dos fiéis e dos santos,",
                "País de glória infinda,",
                "de bênçãos e luz;",
                "Já estamos cansados",
                "de andar pelas trevas;",
                "Ao lar em breve iremos",
                "com Cristo Jesus"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Doce lar! Doce lar!",
                "Doce lar! Doce lar!",
                "No lar habitaremos",
                "Com o nosso Jesus."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Não entram desgostos",
                "neste lar, nem tristeza,",
                "Só paz e alegria",
                "ali reinarão.",
                "Em nosso caminho,",
                "vamos muito animados,",
                "Pois Cristo, nosso Mestre,",
                "nos deu salvação."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Doce lar! Doce lar!",
                "Doce lar! Doce lar!",
                "No lar habitaremos",
                "Com o nosso Jesus."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Sigamos avante",
                "para o lar, bem contentes,",
                "E sempre exaltando",
                "a história da cruz.",
                "Já vemos a terra",
                "com os seus lindos campos;",
                "Ali nós viveremos",
                "com nosso Jesus."
            ]
        },
        {
            "order": 6,
            "chorus": true,
            "image": "",
            "strophe": [
                "Doce lar! Doce lar!",
                "Doce lar! Doce lar!",
                "No lar habitaremos",
                "Com o nosso Jesus."
            ]
        }
