    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Salvo em Jesus, meu Mestre,",
                "tenho perfeita paz.",
                "Tal comunhão com Ele",
                "toda aflição desfaz.",
                "Ele me deu certeza",
                "da minha salvação,",
                "Oh, que prazer glorioso",
                "enche meu coração!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Salvo em Jesus, meu Mestre,",
                "tenho perfeita paz.",
                "Tal comunhão com Ele",
                "toda a aflição desfaz."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Cristo é minha vida,",
                "fonte Ele é de amor.",
                "Tira de mim as mágoas,",
                "todo o pesar e a dor.",
                "E , se eu sofrer a prova,",
                "fácil será ganhar;",
                "E , se verter o pranto,",
                "logo Ele enxugará."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Salvo em Jesus, meu Mestre,",
                "tenho perfeita paz.",
                "Tal comunhão com Ele",
                "toda a aflição desfaz."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Hei de passar a noite",
                "sem mais sentir temor;",
                "Breve virá o dia",
                "de perenal fulgor.",
                "Oh, que prazer supremo",
                "ver a Jesus no lar,",
                "E na mansão de glória",
                "com Ele então reinar!"
            ]
        },
