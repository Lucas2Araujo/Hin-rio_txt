    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vem nos inspirar,",
                "Vem nos ensinar, Senhor,",
                "Na luz do Teu Espírito.",
                "Vem nos animar,",
                "Vem nos transformar, Senhor,",
                "Com Teu poder e glória."
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Senhor, queremos dar louvor",
                "Em gratidão a Ti.",
                "Aceita nosso coração.",
                "Vem transformar nosso ser."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Vem nos ajudar,",
                "Vem nos consolar, Senhor;",
                "Que a Tua paz esteja em nós.",
                "Dá-nos Teu poder",
                "Pra Te obedecer e crer",
                "Em Teu sacrifício."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Senhor, queremos dar louvor",
                "Em gratidão a Ti.",
                "Aceita nosso coração.",
                "Vem transformar nosso ser."
            ]
        }
