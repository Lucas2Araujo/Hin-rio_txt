    "lyrics": [
        {
            "order": 1,
            "chorus": false,
            "image": "",
            "strophe": [
                "Perdido foi que Cristo me encontrou",
                "Neste mundo mau.",
                "Salvou-me, no Seu sangue me lavou.",
                "Hoje sou feliz!"
            ]
        },
        {
            "order": 2,
            "chorus": true,
            "image": "",
            "strophe": [
                "Hoje sou feliz, Foi-se o meu temor.",
                "Vou permanecer Junto ao Salvador.",
                "Foi-se a escuridão; Raia a luz do Céu,",
                "Pois eu sei que sou do meu Senhor,",
                "E Ele é meu."
            ]
        },
        {
            "order": 3,
            "chorus": false,
            "image": "",
            "strophe": [
                "Se muitas tentações me sobrevêm,",
                "Para Ele vou.",
                "Recebo forças que do Céu me vêm",
                "Se com Ele estou."
            ]
        },
        {
            "order": 4,
            "chorus": true,
            "image": "",
            "strophe": [
                "Hoje sou feliz, Foi-se o meu temor.",
                "Vou permanecer Junto ao Salvador.",
                "Foi-se a escuridão; Raia a luz do Céu,",
                "Pois eu sei que sou do meu Senhor,",
                "E Ele é meu."
            ]
        },
        {
            "order": 5,
            "chorus": false,
            "image": "",
            "strophe": [
                "Se escura noite assustar-me vem,",
                "Sinto Seu amor.",
                "As trevas tornam-se em luz também,",
                "Com meu Salvador."
            ]
        },
        {
